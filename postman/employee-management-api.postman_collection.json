{
  "info": {
    "_postman_id": "98d23291-2414-4de6-b782-9675e63bdb12",
    "name": "Employee Management API - Full Collection",
    "description": "Covers every mounted API route. Run requests in order with Collection Runner. Requires the API running and seeded admin account. Test data is created with a unique run ID; a dedicated employee account is used for password/session operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const url = pm.request.url.toString();",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "pm.test('Response body matches the documented API envelope', function () {",
          "  if (pm.response.code === 204) { pm.expect(pm.response.text()).to.eql(''); return; }",
          "  if (url.includes('/health')) { pm.expect(pm.response.json().status).to.be.a('string'); return; }",
          "  if (!contentType.includes('application/json')) return;",
          "  const body = pm.response.json();",
          "  if (pm.response.code >= 400) {",
          "    pm.expect(body.success).to.eql(false);",
          "    pm.expect(body.error).to.be.an('object');",
          "    pm.expect(body.error.code).to.be.a('string');",
          "    pm.expect(body.error.message).to.be.a('string');",
          "    pm.expect(body.error.requestId).to.be.a('string');",
          "  } else {",
          "    pm.expect(body.success).to.eql(true);",
          "    pm.expect(body.requestId).to.be.a('string');",
    "    pm.expect(body).to.have.property('data');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "devPassword", "value": "DevPass#12345" },
    { "key": "changedPassword", "value": "PostmanNew#4567" },
    { "key": "adminToken", "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "accountEmail", "value": "" },
    { "key": "accountEmployeeId", "value": "" },
    { "key": "createdEmployeeId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "testDate", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Health and Admin Login",
      "item": [
        {
          "name": "Health check",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API health is OK', function () { pm.response.to.have.status(200); });"] } }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Liveness probe",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Liveness probe returns live', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('live'); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health/live" }
        },
        {
          "name": "Readiness probe",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Readiness probe returns ready when DB is available', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ready'); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        },
        {
          "name": "Login - admin seeded account",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin login succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.collectionVariables.set('adminToken', body.data.accessToken);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.test\",\n  \"password\": \"{{devPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "GET - current principal (admin)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current principal returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/auth/me" }
        },
        {
          "name": "GET - admin-only check",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin-only check passes for admin', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/auth/admin-only" }
        },
        {
          "name": "GET - employee:create permission check",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin has employee:create permission', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/auth/can-create-employee" }
        }
      ]
    },
    {
      "name": "01 - Departments",
      "item": [
        {
          "name": "GET - list departments",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department list returns 200', function () { pm.response.to.have.status(200); });", "const result = pm.response.json().data;", "pm.test('Department list has data and pagination schema', function () { pm.expect(result.data).to.be.an('array'); pm.expect(result.pagination).to.include.all.keys('page', 'limit', 'total', 'totalPages'); });", "const names = result.data.map((department) => department.name);", "pm.test('Departments are sorted by name ascending', function () { pm.expect(names).to.eql([...names].sort((left, right) => left.localeCompare(right))); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/departments?page=1&limit=20&sortBy=name&order=asc" }
        },
        {
          "name": "POST - create test department",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department create returns 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('departmentId', body.data.id);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Test {{runId}}\",\n  \"description\": \"Department created by the full Postman API collection\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/departments"
          }
        },
        {
          "name": "PATCH - update test department",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department update returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated by Postman run {{runId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/departments/{{departmentId}}"
          }
        }
      ]
    },
    {
      "name": "02 - Employee Accounts and Records (Admin)",
      "item": [
        {
          "name": "POST - register employee account (admin only)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('accountEmail', 'postman-' + pm.collectionVariables.get('runId') + '@example.test');", "pm.collectionVariables.set('testDate', new Date().toISOString().slice(0, 10));"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin can register employee account', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('accountUserId', body.data.id);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Employee\",\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{devPassword}}\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"jobTitle\": \"Postman QA Employee\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "POST - create employee record without login account",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin can create employee record', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.collectionVariables.set('createdEmployeeId', body.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"{{departmentId}}\",\n  \"jobTitle\": \"Standalone Postman Employee\",\n  \"joiningDate\": \"{{testDate}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/employees"
          }
        },
        {
          "name": "GET - list employees",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee list returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/employees?page=1&limit=20&sortBy=createdAt&order=desc" }
        },
        {
          "name": "GET - find registered employee ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Search for new employee returns 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "const employee = body.data.data.find((item) => item.workEmail === pm.collectionVariables.get('accountEmail'));", "pm.test('New employee record is found', function () { pm.expect(employee).to.exist; });", "pm.collectionVariables.set('accountEmployeeId', employee.id);"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/employees?page=1&limit=100&search={{accountEmail}}&sortBy=createdAt&order=desc" }
        },
        {
          "name": "GET - employee by ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Get employee by ID returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}" }
        },
        {
          "name": "PATCH - update employee record",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee update returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"jobTitle\": \"Updated Postman QA Employee\",\n  \"employmentStatus\": \"on_leave\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}"
          }
        }
      ]
    },
    {
      "name": "03 - Employee Self-Service and Access Checks",
      "item": [
        {
          "name": "Login - newly registered employee",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registered employee login succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.collectionVariables.set('employeeToken', body.data.accessToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
