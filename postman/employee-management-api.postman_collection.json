            "url": "{{baseUrl}}/api/v1/auth/change-password"
          }
        },
        {
          "name": "Login - changed password",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login with changed password succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.collectionVariables.set('employeeToken', body.data.accessToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{changedPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
