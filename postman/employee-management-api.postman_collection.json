    {
      "name": "05 - Finish Admin CRUD",
      "item": [
        {
          "name": "DELETE - deactivate standalone employee record",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin deactivation returns 204', function () { pm.response.to.have.status(204); });"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/employees/{{createdEmployeeId}}" }
        }
      ]
    },
    {
      "name": "06 - Employee Documents (Local Multer Storage)",
      "item": [
        {
          "name": "POST - upload employee PDF document",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Document upload returns 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.test('Response contains safe document metadata', function () { pm.expect(body.data).to.have.property('id'); pm.expect(body.data).not.to.have.property('objectKey'); });", "pm.collectionVariables.set('documentId', body.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{documentFile}}" }] },
            "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}/documents"
          }
        },
        {
          "name": "POST - reject unsupported file type",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unsupported upload returns 400', function () { pm.response.to.have.status(400); });", "pm.test('Validation response contains request ID', function () { pm.expect(pm.response.json().error).to.have.property('requestId'); });"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "{{invalidDocumentFile}}" }] },
            "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}/documents"
          }
        },
        {
          "name": "GET - list employee documents",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Document list returns 200', function () { pm.response.to.have.status(200); });", "pm.test('Document list is an array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}/documents" }
        },
        {
          "name": "GET - create authorized short-lived download URL",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Download URL returns 200', function () { pm.response.to.have.status(200); });", "const data = pm.response.json().data;", "pm.test('Download URL expires in five minutes', function () { pm.expect(data.expiresInSeconds).to.eql(300); });", "pm.collectionVariables.set('downloadUrl', data.downloadUrl);"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/download-url" }
        },
        {
          "name": "GET - download using short-lived URL",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Signed download returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "url": "{{downloadUrl}}" }
        },
        {
          "name": "DELETE - soft-delete document",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Document deletion returns 204', function () { pm.response.to.have.status(204); });"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/documents/{{documentId}}" }
        }
      ]
    },
    {
      "name": "07 - User Administration and Data Export",
      "item": [
        {
          "name": "GET - export own profile data",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Own profile export returns 200', function () { pm.response.to.have.status(200); });", "const data = pm.response.json().data;", "pm.test('Export contains user and employee DTOs, not secrets', function () { pm.expect(data.user).to.include.all.keys('id', 'email', 'role', 'isActive', 'createdAt', 'updatedAt'); pm.expect(data.employee).to.include.all.keys('id', 'firstName', 'lastName', 'workEmail', 'departmentId'); pm.expect(data.user).not.to.have.property('passwordHash'); pm.expect(data).not.to.have.property('refreshToken'); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/me/export" }
        },
        {
          "name": "POST - revoke all sessions for test user (admin)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin revokes user sessions with 204', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/users/{{accountUserId}}/sessions/revoke" }
        },
        {
          "name": "PATCH - assign manager role to test user (admin)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin assigns role with 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('Role assignment response schema is valid', function () { pm.expect(body.data).to.eql({ id: pm.collectionVariables.get('accountUserId'), role: 'manager' }); });"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"manager\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/users/{{accountUserId}}/role"
          }
        }
      ]
