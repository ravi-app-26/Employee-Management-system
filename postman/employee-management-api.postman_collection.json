          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/auth/logout-all" }
        },
        {
          "name": "POST - change password for dedicated test account",
