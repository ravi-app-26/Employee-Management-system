            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "GET - employee own principal",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee principal returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/auth/me" }
        },
        {
          "name": "GET - own employee profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Own employee profile returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/employees/me" }
        },
        {
          "name": "PATCH - own employee profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Own profile update returns 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"PostmanUpdated\",\n  \"phone\": \"+1 555 010 0200\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/employees/me"
          }
        },
        {
          "name": "GET - employee list denied for employee role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role cannot list all employees', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/employees?page=1&limit=20" }
        },
        {
          "name": "GET - admin-only endpoint denied for employee role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role cannot access admin-only endpoint', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/auth/admin-only" }
        },
        {
          "name": "GET - create permission denied for employee role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role lacks employee:create', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/auth/can-create-employee" }
        },
        {
          "name": "POST - employee account registration denied for employee role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role cannot register another account', function () { pm.response.to.have.status(403); });"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Denied\",\n  \"lastName\": \"User\",\n  \"email\": \"denied-{{runId}}@example.test\",\n  \"password\": \"{{devPassword}}\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"jobTitle\": \"Denied Account\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "POST - employee record creation denied for employee role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role cannot create employee records', function () { pm.response.to.have.status(403); });"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"{{departmentId}}\",\n  \"jobTitle\": \"Denied Record\",\n  \"joiningDate\": \"{{testDate}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/employees"
          }
        },
        {
          "name": "GET - employee detail denied by employee:read permission",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role cannot use employee detail route without employee:read', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}" }
        },
        {
          "name": "DELETE - employee deactivation denied for employee role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee role cannot deactivate employee records', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/employees/{{accountEmployeeId}}" }
        }
      ]
    },
    {
      "name": "04 - Refresh Tokens and Sessions (Dedicated Test Account)",
      "item": [
        {
          "name": "GET - list active sessions",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Sessions list returns 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.collectionVariables.set('sessionId', body.data[0].id);"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/auth/sessions" }
        },
        {
          "name": "POST - refresh access token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Refresh returns a new access token', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.collectionVariables.set('employeeToken', body.data.accessToken);"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/refresh" }
        },
        {
          "name": "DELETE - revoke one session",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Session revocation returns 204', function () { pm.response.to.have.status(204); });"] } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": "{{baseUrl}}/api/v1/auth/sessions/{{sessionId}}" }
        },
        {
          "name": "POST - logout",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Logout returns 204', function () { pm.response.to.have.status(204); });"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout" }
        },
