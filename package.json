  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate -m migrations --envPath .env up",
