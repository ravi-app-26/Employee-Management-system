    "seed": "tsx seeds/run.ts",
    "test": "jest",
    "test:integration": "docker compose -f docker-compose.test.yml up -d --wait && jest --config jest.integration.config.cjs --runInBand",
    "migrate:up": "node-pg-migrate up -m migrations"
  },
  "keywords": [],
