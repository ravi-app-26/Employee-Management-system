NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/employee_management

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=ems-api
JWT_AUDIENCE=ems-client
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

MAX_DOCUMENT_SIZE_BYTES=5242880
UPLOAD_RETENTION_DAYS=30
AWS_REGION=ap-southeast-2
DOCUMENTS_S3_BUCKET=emp-mt-system
DOCUMENTS_S3_PREFIX=uploads/
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=ems-local
REDIS_CACHE_KEY_PREFIX=cache
REDIS_SESSION_KEY_PREFIX=session
REDIS_TOKEN_KEY_PREFIX=token
REDIS_EVENT_KEY_PREFIX=event
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_SOCKET_TIMEOUT_MS=5000
REDIS_MAX_RECONNECT_RETRIES=5
REDIS_RECONNECT_BASE_DELAY_MS=200
DEPARTMENT_CACHE_TTL_SECONDS=60
PERMISSION_CACHE_TTL_SECONDS=60
SESSION_RECONCILIATION_CRON=*/5 * * * *