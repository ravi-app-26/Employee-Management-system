NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/employee_management

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=ems-api
JWT_AUDIENCE=ems-client
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

UPLOAD_DIR=private-uploads
MAX_DOCUMENT_SIZE_BYTES=5242880
UPLOAD_RETENTION_DAYS=30
PUBLIC_API_BASE_URL=http://localhost:3000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000